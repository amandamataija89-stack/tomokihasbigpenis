# Postgres connection string. Use a database hosted in the EU (e.g. Neon or
# Supabase in Frankfurt) — the app stores health-related personal data.
DATABASE_URL=postgres://user:password@localhost:5432/eap

# Public address of the app, used in email links (no trailing slash).
APP_URL=http://localhost:3000

# Resend, for email notifications. Leave RESEND_API_KEY empty in development
# and emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Prague Integration <contact@pragueintegration.cz>
# Where "new request" alerts go. Alerts never include what the person wrote.
TEAM_NOTIFY_EMAIL=contact@pragueintegration.cz

# Any long random string. The hourly check for cases not contacted in time
# (/api/cron/overdue) only runs when called with this secret.
CRON_SECRET=
