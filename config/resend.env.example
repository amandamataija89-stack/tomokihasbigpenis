# Copy this file to config/resend.env and fill in real values.
# config/resend.env is gitignored — NEVER commit a real API key.

# From your Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Must be an address on a domain you've verified in Resend
# (Domains -> Add Domain -> add the SPF/DKIM/DMARC DNS records Resend gives
# you). Sending from an unverified domain will fail or land in spam.
RESEND_FROM_NAME=Prague Integration
RESEND_FROM_EMAIL=contact@pragueintegration.cz

# Where GP replies should go (can be the same as RESEND_FROM_EMAIL)
RESEND_REPLY_TO=contact@pragueintegration.cz

# Emails sent per second. Keep this low (1-2) — cold outreach at high
# speed hurts deliverability and looks like spam regardless of provider.
RESEND_RATE_PER_SECOND=1
